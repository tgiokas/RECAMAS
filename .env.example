# Copy this file to .env and fill in real local values. .env is gitignored;
# this template is the tracked reference for which keys exist.

ASPNETCORE_ENVIRONMENT=Development

# ==================== Database ====================
RECAMAS_DB_CONNECTION=Host=localhost;Port=5433;Database=recamas_dev;Username=recamas_app;Password=dev_password_only

# ==================== Keycloak ====================
KEYCLOAK_AUTHORITY=http://localhost:8085/realms/recamas
KEYCLOAK_AUDIENCE=recamas-api

# ==================== Kafka ====================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SOCKET_CONNECTION_SETUP_TIMEOUT_MS=10000
KAFKA_SOCKET_TIMEOUT_MS=10000
KAFKA_MESSAGE_TIMEOUT_MS=10000
KAFKA_REQUEST_TIMEOUT_MS=10000

# ==================== Storage (reused microservice) ====================
STORAGE_BASE_URL=http://localhost:8081

# ==================== CY Connect gateway (fronts ARS + CASS) ====================
CYCONNECT_BASE_URL=https://cyconnect.example.gov.cy
CYCONNECT_CLIENT_ID=
CYCONNECT_CLIENT_SECRET=

# ==================== Arrivals/Departures ====================
ARRIVALS_DEPARTURES_BASE_URL=https://arrivals-departures.example.gov.cy

# ==================== Stoplist ====================
STOPLIST_BASE_URL=https://stoplist.example.gov.cy

# ==================== JCC Trust Services (SigningHub) ====================
JCC_BASE_URL=https://api.jcc.com.cy/trust
JCC_CLIENT_ID=
JCC_CLIENT_SECRET=
JCC_CALLBACK_URL=https://recamas.example.gov.cy/api/jcc/callback
