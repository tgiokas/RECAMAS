# Copy this file to .env and fill in real local values. .env is gitignored;
# this template is the tracked reference for which keys exist.

ASPNETCORE_ENVIRONMENT=Development

# ==================== Database ====================
# Host=recamas-db resolves via the docker network; use Host=localhost;Port=5433 instead when running the API outside Docker
RECAMAS_DB_CONNECTION=Host=recamas-db;Port=5432;Database=recamas-dev;Username=recamas-app;Password=dev_password_only

# ==================== Keycloak ====================
KEYCLOAK_AUTHORITY=http://localhost:8085/realms/recamas
KEYCLOAK_AUDIENCE=recamas-api

# ==================== Kafka ====================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_RECONNECT_BACKOFF_MS=100
KAFKA_RECONNECT_BACKOFF_MAX_MS=10000
KAFKA_SOCKET_CONNECTION_SETUP_TIMEOUT_MS=10000
KAFKA_SOCKET_TIMEOUT_MS=10000
KAFKA_RETRY_BACKOFF_MS=100
KAFKA_MESSAGE_TIMEOUT_MS=10000
KAFKA_REQUEST_TIMEOUT_MS=10000
# SASL/TLS — opt-in, leave blank for plaintext (local dev default)
KAFKA_SECURITY_PROTOCOL=
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# ==================== Storage (reused microservice) ====================
STORAGE_BASE_URL=http://localhost:8081

# ==================== CY Connect gateway (fronts ARS + CASS) ====================
CYCONNECT_BASE_URL=https://cyconnect.example.gov.cy
CYCONNECT_CLIENT_ID=
CYCONNECT_CLIENT_SECRET=

# ==================== Interoperability adapters ====================
# ARS_BASE_URL may be omitted when ARS is exposed under CYCONNECT_BASE_URL.
# recamas-api runs in its own container, so "localhost" must be host.docker.internal to reach the external-apis containers published on the host.
ARS_BASE_URL=http://host.docker.internal:5001/
ARS_API_KEY=development-ars-api-key
# CASS remains a development mock until the provider supplies its WSDL/XSD.
CASS_USE_MOCK=true
POLICE_BASE_URL=http://host.docker.internal:5005/
POLICE_API_KEY=development-police-api-key
POLICE_CLIENT_ID=recamas-development

# ==================== Arrivals/Departures ====================
ARRIVALS_DEPARTURES_BASE_URL=https://arrivals-departures.example.gov.cy

# ==================== Stoplist ====================
STOPLIST_BASE_URL=https://stoplist.example.gov.cy

# ==================== JCC Trust Services (SigningHub) ====================
JCC_BASE_URL=https://api.jcc.com.cy/trust
JCC_CLIENT_ID=
JCC_CLIENT_SECRET=
JCC_CALLBACK_URL=https://recamas.example.gov.cy/api/jcc/callback
