<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>RECAMAS.Domain</RootNamespace>
  </PropertyGroup>

  <!--
    Domain layer: entities, enums, and repository interfaces only.
    Nothing here depends on Application, Infrastructure, or API.

    Cbs.Audit.Contract is the one exception to "no external package
    dependencies" (see architecture decision log on adopting Cbs.Audit as a
    package): [Audited]/[MaskedAudit] must live directly on the entity
    declaration to take effect, the same way ekee_v2's own Member.cs does it,
    so Domain has to reference whichever package declares those attributes.
    PLACEHOLDER VERSION — replace with the real published version once this
    restores against the private feed (blocked from this sandbox's network
    policy; see chat).
  -->
  <ItemGroup>
    <PackageReference Include="Cbs.Audit" Version="0.1.8" />
  </ItemGroup>

</Project>
