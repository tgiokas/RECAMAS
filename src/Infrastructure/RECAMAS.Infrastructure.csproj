<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>RECAMAS.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Domain\RECAMAS.Domain.csproj" />
    <ProjectReference Include="..\Application\RECAMAS.Application.csproj" />
  </ItemGroup>

  <!-- Class library, not Web SDK — IHttpContextAccessor (used by the audit
       interceptors to capture the current user) needs the shared framework
       explicitly rather than a NuGet package. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.1" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
    <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="9.0.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="9.0.0" />
  </ItemGroup>

  <!-- Cbs.Audit.EntityFramework (ApplyAuditOutbox) and Cbs.Audit.Abstractions
       (IAuditLabelResolver) — see architecture decision log on adopting
       Cbs.Audit as a package, replacing this project's own outbox/Kafka
       audit pipeline (Confluent.Kafka reference removed above). PLACEHOLDER
       VERSIONS — replace with the real published versions once this restores
       against the private feed (blocked from this sandbox's network policy;
       see chat). -->
  <ItemGroup>
    <PackageReference Include="Cbs.Audit.EntityFramework" Version="1.0.0" />
    <PackageReference Include="Cbs.Audit.Abstractions" Version="1.0.0" />
  </ItemGroup>

</Project>
